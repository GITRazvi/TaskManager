# TaskManager Backend - Environment Configuration Template
# Copy this file to .env and update values for your environment

# ======================
# Database Configuration
# ======================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=taskmanager_db
DB_USER=taskmanager_user
DB_PASSWORD=taskmanager_password

# ======================
# JWT Configuration
# ======================
# IMPORTANT: HS512 requires a strong random string of at least 64 characters.
# Generate with: openssl rand -base64 64
JWT_SECRET=your-secret-key-change-in-production-minimum-64-characters-please
JWT_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# ======================
# Server Configuration
# ======================
SERVER_PORT=8080
SPRING_PROFILE=dev

# ======================
# CORS Configuration
# ======================
# Comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# ======================
# Logging Configuration
# ======================
# Set to: TRACE, DEBUG, INFO, WARN, ERROR
LOG_LEVEL=DEBUG
LOG_PATH=logs/

# ======================
# Database Pool Configuration
# ======================
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=5
DB_POOL_CONNECTION_TIMEOUT=20000

# ======================
# Actuator Configuration
# ======================
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,metrics,info

# ======================
# Production Settings (uncomment when deploying)
# ======================
# SPRING_PROFILE=prod
# JWT_SECRET=<use-strong-random-value-from-openssl>
# DB_HOST=<your-production-db-host>
# DB_PASSWORD=<your-production-db-password>
# CORS_ALLOWED_ORIGINS=https://yourdomain.com
